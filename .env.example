# Copy to .env or run npm run setup. Never commit credentials.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Required: exact sender phone/email ID(s), comma-separated. Unknown senders ignored.
ALLOWED_SENDERS=
# Optional additional restriction: exact Photon conversation ID(s).
ALLOWED_SPACES=
ASIDE_ACCOUNT=u0
ASIDE_TIMEOUT_MS=1200000
# Optional override for an existing official Aside CLI installation:
# ASIDE_CLI=/absolute/path/to/aside
