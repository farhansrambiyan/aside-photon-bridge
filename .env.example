# Run npm run setup from normal macOS Terminal. Do not paste secrets into chats.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Exact Photon sender ID(s), comma-separated. Required: unknown senders are ignored.
ALLOWED_SENDERS=
# Optional additional restriction, exact Photon space ID(s), comma-separated.
ALLOWED_SPACES=
ASIDE_ACCOUNT=u0
ASIDE_TIMEOUT_MS=1200000
# Installed alongside this app; optional override:
# ASIDE_CLI=/absolute/path/to/aside
# Proactive assistant (iMessage mode). Uses Aside's own Gmail/Calendar access.
# Optional: which Google account Aside should use when several are signed in.
GOOGLE_ACCOUNT=
# Checks with no new mail use no AI tokens, so frequent checks are cheap.
EMAIL_CHECK_MINUTES=5
# Gmail account index in Aside (/mail/u/<n>/). Usually 0.
GMAIL_UID=0
# ai = one short AI check only when new mail arrives; rules = no AI at all.
EMAIL_FILTER=ai
EMAIL_CHECK_START_HOUR=8
EMAIL_CHECK_END_HOUR=22
# Optional scheduled daily briefing (HH:MM, 24h). Empty = only when you send /briefing.
BRIEFING_TIME=
# Defaults to this Mac's time zone.
# ASSISTANT_TIMEZONE=Asia/Kolkata

# Photos, videos, files and voice notes you send are saved here and handed to Aside by path.
# Keep this folder somewhere Aside may read (the default is inside the bridge folder).
# MEDIA_DIR=
MEDIA_MAX_MB=100
MEDIA_KEEP_DAYS=3
# Voice notes: show "Heard: ..." before answering (off to hide).
ECHO_TRANSCRIPT=on
# auto tries, in order: local (npm run setup-voice), api, command. off disables voice.
VOICE_BACKEND=auto
VOICE_MODEL=small
# VOICE_LANGUAGE=en
# Optional cloud transcription (audio leaves this Mac). Any OpenAI-compatible service; Groq has a free tier.
# VOICE_API_URL=https://api.groq.com/openai/v1
# VOICE_API_KEY=
# VOICE_API_MODEL=whisper-large-v3-turbo
# Optional: any local program that prints the text. {file} is replaced with the audio path.
# VOICE_COMMAND=whisper-cli -m /path/to/model.bin -nt -f {file}
